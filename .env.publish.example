# Copy to .env.publish (gitignored). Never commit or share the real API key.
# Create an API key and connect Instagram + YouTube + TikTok in the Zernio dashboard.
ZERNIO_API_KEY=

# Optional when exactly one active account is connected for each platform.
# Run npm run publish-daily -- --accounts to find these IDs.
ZERNIO_INSTAGRAM_ACCOUNT_ID=
ZERNIO_YOUTUBE_ACCOUNT_ID=
ZERNIO_TIKTOK_ACCOUNT_ID=
