---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  compactContent?: boolean;
}

const {
  title,
  description = "Building apps for teachers that solve real problems.",
  compactContent = false,
} = Astro.props;

const pageGap = compactContent ? "gap-8" : "gap-12 sm:gap-16 md:gap-20";
const cfBeaconToken = import.meta.env.CF_BEACON?.trim();
const cfBeaconConfig = cfBeaconToken
  ? JSON.stringify({ token: cfBeaconToken })
  : undefined;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim();
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
const eventsOpen = isActive("/events");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fffdf8" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      turnstileSiteKey && (
        <script
          is:inline
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
        />
      )
    }
    {
      cfBeaconConfig && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={cfBeaconConfig}
        />
      )
    }
    <title>{title ? `${title} – teacher.dev` : "teacher.dev"}</title>
  </head>
  <body class="text-slate-950">
    <div
      class={`page-shell mx-auto flex min-h-screen w-full max-w-5xl flex-col ${pageGap} px-4 py-6 sm:px-8 lg:px-20`}
    >
      <header
        class="flex flex-col gap-5 border-b border-slate-200 pb-6 sm:flex-row sm:items-center sm:justify-between"
      >
        <a href="/" class="flex w-fit items-center gap-3" aria-label="teacher.dev home">
          <img src="/favicon.svg" alt="" class="h-12 w-12 shrink-0" />
          <span class="flex flex-col">
            <span class="font-display text-4xl leading-none text-slate-950">teacher.dev</span>
            <span class="mt-1 text-[0.625rem] font-bold uppercase leading-tight tracking-wide text-slate-600">
              Building apps for teachers that solve real problems
            </span>
          </span>
        </a>

        <nav class="flex flex-wrap items-center gap-6 text-sm font-semibold sm:justify-end">
          <a
            href="/daily"
            class={`py-1 text-slate-700 underline-offset-4 decoration-2 transition hover:text-slate-950 hover:underline ${
              isActive("/daily") ? "font-bold text-slate-950 underline" : ""
            }`}
          >
            Every Day
          </a>

          <a
            href="/solutions"
            class={`py-1 text-slate-700 underline-offset-4 decoration-2 transition hover:text-slate-950 hover:underline ${
              isActive("/solutions") ? "font-bold text-slate-950 underline" : ""
            }`}
          >
            Apps
          </a>

          <a
            href="/newsletters"
            class={`py-1 text-slate-700 underline-offset-4 decoration-2 transition hover:text-slate-950 hover:underline ${
              isActive("/newsletters") ? "font-bold text-slate-950 underline" : ""
            }`}
          >
            Newsletter
          </a>

          <details class="group relative">
            <summary
              class="group/summary flex cursor-pointer list-none items-center gap-1 py-1 text-slate-700 transition hover:text-slate-950 [&::-webkit-details-marker]:hidden"
            >
              <span
                class={`underline-offset-4 decoration-2 group-hover/summary:underline ${
                  eventsOpen ? "font-bold text-slate-950 underline" : ""
                }`}
              >
                Events
              </span>
              <span class="text-xs transition group-open:rotate-180" aria-hidden="true">▾</span>
            </summary>
            <div
              class="absolute right-0 z-20 mt-3 w-56 bg-[#fffdf8] py-2 text-slate-700 shadow-lg"
            >
              <a
                href="/events/edtech-a-thon-2026"
                class={`block px-3 py-2 underline-offset-4 decoration-2 transition hover:text-slate-950 hover:underline ${
                  isActive("/events/edtech-a-thon-2026")
                    ? "font-bold text-slate-950 underline"
                    : ""
                }`}
              >
                EdTech-a-thon 2026
              </a>
            </div>
          </details>
        </nav>
      </header>

      <main class={`flex flex-1 flex-col ${pageGap}`}>
        <slot />
      </main>

      <footer class="border-t border-slate-300 py-6 text-center text-sm leading-6 text-slate-600">
        <p class="text-balance">
          Made with <span aria-label="love">❤️</span> for teachers, by a team who believes educators will <span class="underline decoration-2 underline-offset-4">continue</span> to be the future of learning
        </p>
        <p class="mt-1">
          Contact us at <a
            href="mailto:directors@teacher.dev"
            class="font-bold text-slate-700 underline underline-offset-4 transition hover:text-slate-950"
          >directors@teacher.dev</a>
        </p>
      </footer>
    </div>
  </body>
</html>
