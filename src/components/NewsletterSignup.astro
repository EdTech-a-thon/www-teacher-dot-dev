---
interface Props {
  autofocus?: boolean;
  compact?: boolean;
  id: string;
}

const { autofocus = false, compact = false, id } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim();
---

<div class="flex flex-col gap-2" data-newsletter-signup>
  <form
    method="post"
    action="https://wrench-bobsled.exe.xyz/subscribe"
    class="flex flex-col gap-3"
    data-newsletter-form
  >
    <div class="flex flex-col gap-3 sm:flex-row">
      <label for={`${id}-email`} class="sr-only">Email address</label>
      <input
        id={`${id}-email`}
        type="email"
        name="email"
        autocomplete="email"
        placeholder="you@example.com"
        required
        autofocus={autofocus}
        class="min-w-0 flex-1 rounded-full border border-slate-300 bg-white px-5 py-3 text-base text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-primary-500 focus:ring-2 focus:ring-primary-200"
      />
      <button
        type="submit"
        class="inline-flex items-center justify-center rounded-full bg-primary-200 px-5 py-3 text-sm font-bold text-primary-900 transition hover:bg-primary-100 disabled:cursor-wait disabled:opacity-70"
      >
        Sign Up for Our Newsletter
      </button>
    </div>
    <input
      type="text"
      name="website"
      tabindex="-1"
      autocomplete="off"
      hidden
    />
    {
      turnstileSiteKey && (
        <div
          class="cf-turnstile w-full max-w-[300px]"
          data-sitekey={turnstileSiteKey}
          data-action="newsletter_signup"
          data-appearance="execute"
          data-execution="execute"
          data-size="flexible"
          data-theme="light"
          data-newsletter-turnstile
        />
      )
    }
  </form>
  <p
    class:list={["text-sm text-slate-600", { "min-h-5": !compact }]}
    aria-live="polite"
    data-newsletter-status
  >
    {!compact && "Get updates about future events and the tools we build for educators."}
  </p>
</div>

<script>
  const turnstileWaitMs = 60_000;

  function readTurnstileToken(form: HTMLFormElement) {
    const tokenInput = form.elements.namedItem("cf-turnstile-response");
    return tokenInput instanceof HTMLInputElement ? tokenInput.value : "";
  }

  function waitForTurnstileToken(form: HTMLFormElement) {
    const widget = form.querySelector("[data-newsletter-turnstile]");
    if (!(widget instanceof HTMLElement)) {
      return Promise.reject(new Error("Newsletter signup is not configured."));
    }

    const existingToken = readTurnstileToken(form);
    if (existingToken) return Promise.resolve(existingToken);

    return new Promise<string>((resolve, reject) => {
      const deadline = Date.now() + turnstileWaitMs;
      let challengeStarted = false;

      function checkForToken() {
        const token = readTurnstileToken(form);
        if (token) {
          resolve(token);
        } else if (Date.now() >= deadline) {
          reject(new Error("Verification timed out. Please try again."));
        } else {
          const turnstile = Reflect.get(window, "turnstile");
          if (
            !challengeStarted &&
            turnstile &&
            typeof turnstile.execute === "function"
          ) {
            turnstile.execute(widget);
            challengeStarted = true;
          }
          window.requestAnimationFrame(checkForToken);
        }
      }

      checkForToken();
    });
  }

  function resetTurnstile(form: HTMLFormElement) {
    const widget = form.querySelector("[data-newsletter-turnstile]");
    const turnstile = Reflect.get(window, "turnstile");

    if (
      widget instanceof HTMLElement &&
      turnstile &&
      typeof turnstile.reset === "function"
    ) {
      turnstile.reset(widget);
    }
  }

  document.querySelectorAll("[data-newsletter-form]").forEach((form) => {
    if (!(form instanceof HTMLFormElement) || form.dataset.enhanced === "true") return;
    form.dataset.enhanced = "true";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const emailInput = form.elements.namedItem("email");
      const websiteInput = form.elements.namedItem("website");
      const submitButton = form.querySelector("button[type='submit']");
      const status = form
        .closest("[data-newsletter-signup]")
        ?.querySelector("[data-newsletter-status]");

      if (!(emailInput instanceof HTMLInputElement)) return;

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
        submitButton.textContent = "Signing Up…";
      }
      if (status instanceof HTMLElement) {
        status.textContent = "Checking your browser…";
        status.classList.remove("text-red-700", "text-primary-700");
      }

      try {
        const turnstileToken = await waitForTurnstileToken(form);
        if (status instanceof HTMLElement) {
          status.textContent = "Submitting your email…";
        }

        const body = new URLSearchParams({
          email: emailInput.value,
          website:
            websiteInput instanceof HTMLInputElement ? websiteInput.value : "",
          "cf-turnstile-response": turnstileToken,
        });
        const response = await fetch(form.action, {
          method: "POST",
          headers: {
            "Content-Type": "application/x-www-form-urlencoded",
            Accept: "application/json",
          },
          body,
        });
        const result = await response.json();

        if (!response.ok) throw new Error(result.message || "Unable to subscribe");

        form.reset();
        if (status instanceof HTMLElement) {
          status.textContent = result.message;
          status.classList.add("text-primary-700");
        }
      } catch (error) {
        if (status instanceof HTMLElement) {
          status.textContent =
            error instanceof Error
              ? error.message
              : "Unable to subscribe. Please try again.";
          status.classList.add("text-red-700");
        }
      } finally {
        resetTurnstile(form);
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
          submitButton.textContent = "Sign Up for Our Newsletter";
        }
      }
    });
  });
</script>
