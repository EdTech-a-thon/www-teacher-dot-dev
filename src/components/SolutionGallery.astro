---
import type { GalleryItem } from "../lib/board";
import { Image } from "astro:assets";
import ReelTabs from "./ReelTabs.astro";
import SocialPosts from "./SocialPosts.astro";

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
const modalItems = items.map((item) => ({
  key: item.key,
  name: item.name,
  oneLiner: item.oneLiner,
  descriptionHtml: item.descriptionHtml,
  link: item.link,
  builtBy: item.builtBy,
  date: item.date,
  screenshot: item.screenshot
    ? {
        src: item.screenshot.src,
        width: item.screenshot.width,
        height: item.screenshot.height,
      }
    : null,
}));
const modalJson = JSON.stringify(modalItems).replace(/</g, "\\u003c");
---

{
  items.length === 0 ? (
    <p class="py-8 text-center italic text-slate-500">
      No completed apps yet — check back during the event.
    </p>
  ) : (
    <div data-app-browser>
      <div class="sm:max-w-sm">
        <label
          for="app-search"
          class="block text-xs font-extrabold uppercase tracking-wide text-primary-700"
        >
          Search apps
        </label>
        <input
          id="app-search"
          type="search"
          data-app-search
          autocomplete="off"
          placeholder="Try “math”, “library”, or a builder’s name"
          class="mt-1 w-full rounded-lg border border-slate-400 border-b-4 bg-white px-3 py-2 text-slate-900 placeholder:text-slate-400 focus:border-primary-500 focus:outline-none"
        />
      </div>

      <p class="mt-3 text-sm text-slate-600" data-app-count aria-live="polite" />

      <div
        class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
        data-app-grid
      >
        {items.map((item) => (
          <a
            href={`/apps/${item.key}/`}
            data-solution-open={item.key}
            data-app-card
            data-app-search-text={item.searchText}
            class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white text-left shadow-sm transition hover:-translate-y-1 hover:border-primary-300 hover:shadow-xl"
          >
            <div class="relative aspect-video w-full overflow-hidden bg-gradient-to-br from-primary-200 to-primary-400">
              {item.screenshot ? (
                <Image
                  src={item.screenshot}
                  alt={`${item.name} screenshot`}
                  widths={[480, 720]}
                  sizes="(min-width: 1024px) 280px, (min-width: 640px) 45vw, 90vw"
                  loading="lazy"
                  class="h-full w-full object-cover transition group-hover:scale-105"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center p-4 text-center font-display text-xl text-primary-950">
                  {item.name}
                </div>
              )}
              {item.reels.length > 0 && (
                <span class="absolute bottom-2 left-2 inline-flex items-center gap-1 rounded-full bg-slate-950/70 px-2 py-0.5 text-xs font-bold text-white">
                  <svg viewBox="0 0 24 24" class="h-3 w-3 fill-current" aria-hidden="true">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                  {item.reels.length} reel{item.reels.length === 1 ? "" : "s"}
                </span>
              )}
            </div>
            <div class="flex grow flex-col gap-1 p-4">
              <h2 class="text-lg font-bold leading-snug text-slate-900">
                {item.name}
              </h2>
              {item.oneLiner && (
                <p class="line-clamp-2 text-sm text-slate-600">
                  {item.oneLiner}
                </p>
              )}
              {item.builtBy && (
                <p class="mt-auto pt-2 text-xs text-slate-500">
                  Built by {item.builtBy}
                </p>
              )}
            </div>
          </a>
        ))}
      </div>

      <p
        class="hidden py-10 text-center italic text-slate-500"
        data-app-empty
      >
        No apps match that search.
      </p>
    </div>
  )
}

{
  items.length > 0 && (
    <>
      {items.map((item) => (
        <template data-solution-social={item.key}>
          <ReelTabs reels={item.reels} name={item.name} class="mt-6 border-t border-slate-200 pt-4" />
          <SocialPosts posts={item.socialPosts} />
        </template>
      ))}
      <script
        id="solution-gallery-data"
        type="application/json"
        set:html={modalJson}
      />
      <div
        data-solution-modal
        class="fixed inset-0 z-50 hidden items-start justify-center overflow-y-auto bg-slate-950/60 p-4 backdrop-blur-sm"
        role="dialog"
        aria-modal="true"
        aria-label="App details"
        tabindex="-1"
      >
        <div
          data-solution-modal-document
          class="my-8 w-full max-w-2xl overflow-hidden rounded-2xl bg-white shadow-2xl"
          role="document"
        >
          <div data-solution-media />
          <div class="p-5 sm:p-6">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2
                  data-solution-title
                  class="text-2xl font-extrabold text-slate-900"
                />
                <p data-solution-meta class="mt-0.5 text-sm text-slate-500" />
              </div>
              <button
                type="button"
                data-solution-close
                aria-label="Close"
                class="shrink-0 rounded-full p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-900"
              >
                <svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden="true">
                  <path
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    d="M6 6l12 12M18 6L6 18"
                  />
                </svg>
              </button>
            </div>
            <div
              data-solution-description
              class="modal-description mt-4 text-sm leading-relaxed text-slate-700"
            />
            <div data-solution-social-container />
            <div data-solution-actions class="mt-6 flex flex-wrap gap-3" />
          </div>
        </div>
      </div>
    </>
  )
}

<script>
  const dataEl = document.getElementById("solution-gallery-data");
  const modal = document.querySelector("[data-solution-modal]");
  const modalDocument = document.querySelector("[data-solution-modal-document]");
  const media = document.querySelector("[data-solution-media]");
  const title = document.querySelector("[data-solution-title]");
  const meta = document.querySelector("[data-solution-meta]");
  const description = document.querySelector("[data-solution-description]");
  const actions = document.querySelector("[data-solution-actions]");
  const social = document.querySelector("[data-solution-social-container]");
  const closeButton = document.querySelector("[data-solution-close]");
  const items = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];
  const byKey = new Map(items.map((item) => [item.key, item]));

  function closeSolution() {
    if (!(modal instanceof HTMLElement)) return;
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
    // Unmount iframe media so closing the modal stops playback.
    social?.replaceChildren();
    media?.replaceChildren();
    if (location.hash) {
      history.replaceState(null, "", location.pathname + location.search);
    }
  }

  function openSolution(key) {
    const item = byKey.get(key);
    if (!item || !(modal instanceof HTMLElement)) return;

    if (media instanceof HTMLElement) {
      media.innerHTML = item.screenshot
        ? `<div class="aspect-video w-full overflow-hidden bg-slate-100"><img src="${item.screenshot.src}" alt="${item.name} screenshot" width="${item.screenshot.width}" height="${item.screenshot.height}" class="h-full w-full object-cover" /></div>`
        : "";
    }

    if (title instanceof HTMLElement) title.textContent = item.name;
    if (meta instanceof HTMLElement) {
      meta.textContent = [
        item.builtBy ? `Built by ${item.builtBy}` : "",
        item.date,
      ]
        .filter(Boolean)
        .join(" • ");
    }
    if (description instanceof HTMLElement) {
      description.innerHTML = item.descriptionHtml || item.oneLiner || "";
    }
    if (actions instanceof HTMLElement) {
      actions.innerHTML = item.link
        ? `<a href="${item.link}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-primary-500">Visit app <span aria-hidden="true">&rarr;</span></a>`
        : "";
      const detailLink = document.createElement("a");
      detailLink.href = `/apps/${encodeURIComponent(item.key)}/`;
      detailLink.textContent = "Open app page →";
      detailLink.className = "inline-flex items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-50";
      actions.append(detailLink);
    }
    if (social instanceof HTMLElement) {
      const template = [...document.querySelectorAll<HTMLTemplateElement>("template[data-solution-social]")]
        .find((element) => element.dataset.solutionSocial === key);
      social.replaceChildren(...(template ? [template.content.cloneNode(true)] : []));
    }
    modal.scrollTop = 0;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
    // Keep the address shareable: /apps#<app> opens this popup.
    history.replaceState(null, "", `#${encodeURIComponent(key)}`);
  }

  function openFromHash() {
    const key = decodeURIComponent(location.hash.slice(1));
    if (byKey.has(key)) openSolution(key);
  }

  document.addEventListener("click", (event) => {
    if (!(event instanceof MouseEvent) || event.button !== 0) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

    const trigger = event.target.closest("[data-solution-open]");
    if (trigger instanceof HTMLElement) {
      event.preventDefault();
      openSolution(trigger.dataset.solutionOpen);
    }
  });

  closeButton?.addEventListener("click", closeSolution);
  modal?.addEventListener("click", closeSolution);
  modalDocument?.addEventListener("click", (event) => event.stopPropagation());
  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeSolution();
  });
  window.addEventListener("hashchange", openFromHash);
  openFromHash();
</script>

<script>
  // The grid arrives newest-first from the build, so searching only hides the
  // cards that don't match — nothing is reordered.
  const browser = document.querySelector("[data-app-browser]");
  const searchInput = browser?.querySelector("[data-app-search]");
  const grid = browser?.querySelector("[data-app-grid]");
  const empty = browser?.querySelector("[data-app-empty]");
  const count = browser?.querySelector("[data-app-count]");

  if (grid instanceof HTMLElement && searchInput instanceof HTMLInputElement) {
    const cards = [...grid.querySelectorAll<HTMLElement>("[data-app-card]")];
    const total = cards.length;

    function apply() {
      const terms = searchInput.value.toLowerCase().split(/\s+/).filter(Boolean);

      // Inline display beats the card's own `flex` utility class.
      const visible = cards.filter((card) => {
        const haystack = card.dataset.appSearchText ?? "";
        const shown = terms.every((term) => haystack.includes(term));
        card.style.display = shown ? "" : "none";
        return shown;
      });

      if (empty instanceof HTMLElement) {
        empty.classList.toggle("hidden", visible.length > 0);
      }
      if (count instanceof HTMLElement) {
        count.textContent =
          visible.length === total
            ? `${total} app${total === 1 ? "" : "s"}`
            : `${visible.length} of ${total} app${total === 1 ? "" : "s"}`;
      }
    }

    searchInput.addEventListener("input", apply);
    apply();
  }
</script>

<style>
  :global(.modal-description > * + *) {
    margin-top: 0.75rem;
  }

  :global(.modal-description ul),
  :global(.modal-description ol) {
    padding-left: 1.25rem;
  }

  :global(.modal-description ul) {
    list-style: disc;
  }

  :global(.modal-description ol) {
    list-style: decimal;
  }

  :global(.modal-description a) {
    color: var(--color-primary-700);
    text-decoration: underline;
  }
</style>
