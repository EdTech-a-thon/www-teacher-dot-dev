---
import {
  CALENDAR_WEEKDAYS,
  getCalendarMonths,
  type DailyEntry,
} from "../lib/daily";

interface Props {
  entries: DailyEntry[];
}

const { entries } = Astro.props;
const months = getCalendarMonths(entries);
const latest = entries[0];
---

{
  months.length > 0 && (
    <div
      data-daily-calendar
      class="w-full rounded-lg border border-slate-400 border-b-4 bg-white p-4"
    >
      {months.map((month, index) => (
        <div data-calendar-month hidden={index !== 0}>
          <div class="flex items-center justify-between gap-2">
            <h4 class="font-extrabold text-slate-950">{month.label}</h4>
            {months.length > 1 && (
              <div class="flex gap-1">
                <button
                  type="button"
                  data-calendar-step="1"
                  disabled={index === months.length - 1}
                  aria-label="Previous month"
                  class="rounded-full p-1 text-slate-600 transition hover:bg-slate-100 hover:text-slate-950 disabled:invisible"
                >
                  <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
                    <path
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15 18l-6-6 6-6"
                    />
                  </svg>
                </button>
                <button
                  type="button"
                  data-calendar-step="-1"
                  disabled={index === 0}
                  aria-label="Next month"
                  class="rounded-full p-1 text-slate-600 transition hover:bg-slate-100 hover:text-slate-950 disabled:invisible"
                >
                  <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
                    <path
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 18l6-6-6-6"
                    />
                  </svg>
                </button>
              </div>
            )}
          </div>

          <div class="mt-3 grid grid-cols-7 gap-1 text-center text-sm">
            {CALENDAR_WEEKDAYS.map((weekday) => (
              <span
                class="pb-1 text-xs font-bold text-slate-500"
                aria-hidden="true"
              >
                {weekday}
              </span>
            ))}
            {Array.from({ length: month.leadingBlanks }, () => (
              <span aria-hidden="true" />
            ))}
            {month.days.map(({ dayOfMonth, entry, inChallenge }) =>
              entry ? (
                <a
                  href={`/daily/${entry.id}`}
                  aria-label={`Learn more about Day ${entry.day}, ${entry.dateLabel}: ${entry.title}`}
                  aria-current={entry === latest ? "date" : undefined}
                  class={`flex aspect-square items-center justify-center rounded font-bold text-primary-950 transition hover:bg-primary-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700 ${
                    entry === latest
                      ? "bg-primary-300 ring-2 ring-primary-700"
                      : "bg-primary-200"
                  }`}
                >
                  {entry.day}
                </a>
              ) : (
                <span
                  class={`flex aspect-square items-center justify-center rounded ${
                    inChallenge ? "text-slate-500" : "text-slate-300"
                  }`}
                  aria-hidden="true"
                >
                  {dayOfMonth}
                </span>
              ),
            )}
          </div>
        </div>
      ))}
    </div>
  )
}

<script>
  document
    .querySelectorAll<HTMLElement>("[data-daily-calendar]")
    .forEach((calendar) => {
      const months = [
        ...calendar.querySelectorAll<HTMLElement>("[data-calendar-month]"),
      ];

      calendar.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;
        const step = event.target.closest<HTMLElement>("[data-calendar-step]");
        if (!step) return;

        const current = months.findIndex((month) => !month.hidden);
        const next = months[current + Number(step.dataset.calendarStep)];
        if (next) {
          months[current].hidden = true;
          next.hidden = false;
        }
      });
    });
</script>
