---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  newsletter: CollectionEntry<"newsletters">;
}

const { newsletter } = Astro.props;
const issueLabel = newsletter.data.issueNumber
  ? `Issue #${newsletter.data.issueNumber}`
  : "Newsletter";
const formattedDate = new Intl.DateTimeFormat("en", {
  month: "short",
  day: "numeric",
  year: "numeric",
}).format(new Date(`${newsletter.data.date}T00:00:00`));
---

<article class="overflow-hidden rounded-lg border border-slate-400 border-b-4 bg-white">
  <a href={`/newsletters/${newsletter.id}`} class="group flex h-full flex-col">
    <div class="aspect-[16/9] overflow-hidden border-b border-slate-300 bg-slate-100">
      <Image
        src={newsletter.data.thumbnail}
        alt={newsletter.data.thumbnailAlt || ""}
        class="h-full w-full object-cover transition group-hover:scale-[1.02]"
        widths={[400, 640, 800]}
        sizes="(min-width: 768px) 400px, 100vw"
      />
    </div>
    <div class="flex grow flex-col p-5">
      <p class="text-xs font-extrabold uppercase tracking-wide text-primary-700">
        {issueLabel} · {formattedDate}
      </p>
      <h3 class="mt-2 text-xl font-extrabold leading-snug text-slate-950 group-hover:text-primary-700">
        {newsletter.data.title}
      </h3>
      <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-700">
        {newsletter.data.preview}
      </p>
      <span class="mt-auto pt-5 text-sm font-bold text-slate-700 underline-offset-4 decoration-2 transition group-hover:text-slate-950 group-hover:underline">
        Read →
      </span>
    </div>
  </a>
</article>
