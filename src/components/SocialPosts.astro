---
interface Post {
  platform: "instagram" | "tiktok";
  url: string;
}

interface Reel {
  href: string;
  label: string;
}

interface Props {
  posts: Post[];
  reels?: Reel[];
}

const { posts, reels = [] } = Astro.props;
const labels = { instagram: "Instagram", tiktok: "TikTok" } as const;
---

{(reels.length > 0 || posts.length > 0) && (
  <nav
    class="mt-6 border-t border-slate-200 pt-4"
    aria-label="Videos about this app"
  >
    <h2 class="text-xs font-extrabold uppercase tracking-wide text-primary-700">
      Watch the reels
    </h2>
    <ul class="mt-2 flex flex-wrap gap-2">
      {reels.map((reel) => (
        <li>
          <a
            href={reel.href}
            class="inline-block rounded-full bg-primary-100 px-3 py-1 text-sm font-bold text-primary-900 transition hover:bg-primary-200"
          >
            {reel.label}
          </a>
        </li>
      ))}
      {posts.map((post) => (
        <li>
          <a
            href={post.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-full bg-primary-100 px-3 py-1 text-sm font-bold text-primary-900 transition hover:bg-primary-200"
          >
            Watch on {labels[post.platform]} <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
