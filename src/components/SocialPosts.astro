---
// Links out to the same video on other platforms. Instagram Reels are shown
// inline by ReelTabs, so only the other platforms are listed here.
interface Post {
  platform: "instagram" | "tiktok";
  url: string;
}

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const labels = { instagram: "Instagram", tiktok: "TikTok" } as const;
const offsite = posts.filter((post) => post.platform !== "instagram");
---

{offsite.length > 0 && (
  <nav class="mt-6" aria-label="This app on other platforms">
    <h2 class="text-xs font-extrabold uppercase tracking-wide text-primary-700">
      Also watch
    </h2>
    <ul class="mt-2 flex flex-wrap gap-2">
      {offsite.map((post) => (
        <li>
          <a
            href={post.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-full bg-primary-100 px-3 py-1 text-sm font-bold text-primary-900 transition hover:bg-primary-200"
          >
            Watch on {labels[post.platform]} <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
