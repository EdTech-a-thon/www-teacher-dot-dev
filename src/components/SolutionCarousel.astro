---
import { Image } from "astro:assets";
import type { GalleryItem } from "../lib/board";

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section aria-labelledby="solutions-carousel-heading" class="pb-10">
      <div class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2
            id="solutions-carousel-heading"
            class="mt-1 font-display text-4xl text-slate-950"
          >
            Solution Gallery
          </h2>
          <p class="mt-2 max-w-2xl text-slate-600">
            Browse the first solutions built by teachers and developers at
            EdTech-a-thon.
          </p>
        </div>
        <a
          href="/solutions"
          class="inline-flex w-fit items-center justify-center py-1 text-sm font-semibold text-slate-700 underline-offset-4 decoration-2 transition hover:text-slate-950 hover:underline"
        >
          View all solutions <span aria-hidden="true" class="ml-1">→</span>
        </a>
      </div>

      <div class="relative" data-solution-carousel>
        <div
          class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          data-solution-carousel-track
          aria-label="Featured solutions"
        >
          {items.map((item) => (
            <a
              href="/solutions"
              class="group flex w-[82%] shrink-0 snap-start flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white text-left shadow-sm transition hover:-translate-y-1 hover:border-primary-300 hover:shadow-xl sm:w-[45%] lg:w-[31%]"
            >
              <div class="relative aspect-video w-full overflow-hidden bg-gradient-to-br from-primary-200 to-primary-400">
                {item.videoThumb ? (
                  <img
                    src={item.videoThumb}
                    alt=""
                    loading="lazy"
                    class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                  />
                ) : item.screenshot ? (
                  <Image
                    src={item.screenshot}
                    alt={`${item.name} screenshot`}
                    widths={[360, 520, 720]}
                    sizes="(min-width: 1024px) 280px, (min-width: 640px) 45vw, 82vw"
                    loading="lazy"
                    class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center p-4 text-center font-display text-xl text-primary-950">
                    {item.name}
                  </div>
                )}
              </div>
              <div class="flex grow flex-col gap-2 p-4">
                <h3 class="text-lg font-bold leading-snug text-slate-900">
                  {item.name}
                </h3>
                {item.oneLiner && (
                  <p class="line-clamp-3 text-sm leading-6 text-slate-600">
                    {item.oneLiner}
                  </p>
                )}
                {item.builtBy && (
                  <p class="mt-auto pt-2 text-xs font-medium text-slate-500">
                    Built by {item.builtBy}
                  </p>
                )}
              </div>
            </a>
          ))}
        </div>

        <div class="mt-3 flex justify-end gap-2">
          <button
            type="button"
            data-solution-carousel-prev
            class="rounded-full border border-slate-200 bg-white p-2 text-slate-700 shadow-sm transition hover:border-primary-300 hover:text-slate-950"
            aria-label="Previous solutions"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 18l-6-6 6-6"
              />
            </svg>
          </button>
          <button
            type="button"
            data-solution-carousel-next
            class="rounded-full border border-slate-200 bg-white p-2 text-slate-700 shadow-sm transition hover:border-primary-300 hover:text-slate-950"
            aria-label="Next solutions"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 18l6-6-6-6"
              />
            </svg>
          </button>
        </div>
      </div>
    </section>
  )
}

<script>
  document.querySelectorAll("[data-solution-carousel]").forEach((carousel) => {
    const track = carousel.querySelector("[data-solution-carousel-track]");
    const previous = carousel.querySelector("[data-solution-carousel-prev]");
    const next = carousel.querySelector("[data-solution-carousel-next]");

    if (!(track instanceof HTMLElement)) return;

    const scrollByCard = (direction: number) => {
      const card = track.querySelector("a");
      const amount = card instanceof HTMLElement ? card.offsetWidth + 16 : track.clientWidth;
      track.scrollBy({ left: amount * direction, behavior: "smooth" });
    };

    previous?.addEventListener("click", () => scrollByCard(-1));
    next?.addEventListener("click", () => scrollByCard(1));
  });
</script>
