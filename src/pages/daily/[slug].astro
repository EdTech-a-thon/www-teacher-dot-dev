---
import InstagramReel from "../../components/InstagramReel.astro";
import Layout from "../../components/Layout.astro";
import { getDailyEntries, type DailyEntry } from "../../lib/daily";

export async function getStaticPaths() {
  const entries = await getDailyEntries();
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, newer: entries[index - 1], older: entries[index + 1] },
  }));
}

interface Props {
  entry: DailyEntry;
  newer?: DailyEntry;
  older?: DailyEntry;
}

const { entry, newer, older } = Astro.props;
---

<Layout
  title={`Day ${entry.day}: ${entry.title}`}
  description={`Day ${entry.day} of solving a teacher's problem every single day: ${entry.title}`}
  compactContent
>
  <article class="w-full">
    <a
      href="/daily"
      class="py-1 text-sm font-bold text-slate-700 underline-offset-4 decoration-2 transition hover:text-slate-950 hover:underline"
    >
      ← Every day
    </a>

    <div class="mt-6 grid gap-8 md:grid-cols-[1fr_22rem] md:items-start">
      <div>
        <p class="text-sm font-extrabold uppercase tracking-wide text-primary-700">
          Day {entry.day} · {entry.dateLabel}
        </p>
        <h1 class="mt-3 text-4xl font-semibold leading-tight text-slate-900">
          {entry.title}
        </h1>
        {
          entry.descriptionHtml && (
            <div
              class="daily-prose mt-5 text-lg leading-8 text-slate-700"
              set:html={entry.descriptionHtml}
            />
          )
        }
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={entry.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-primary-500"
          >
            Watch on Instagram <span aria-hidden="true">→</span>
          </a>
          {entry.tryUrl && (
            <a
              href={entry.tryUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-primary-700"
            >
              Try it <span aria-hidden="true">→</span>
            </a>
          )}
        </div>

        {
          entry.solution && (
            <a
              href={`/apps/${entry.solution.key}/`}
              class="group mt-8 block rounded-lg border border-slate-400 border-b-4 bg-white p-5 transition hover:border-primary-400"
            >
              <p class="text-xs font-extrabold uppercase tracking-wide text-primary-700">
                The full app
              </p>
              <h2 class="mt-1 text-xl font-extrabold text-slate-950 group-hover:text-primary-700">
                {entry.solution.name}
              </h2>
              {entry.solution.oneLiner && (
                <p class="mt-2 text-sm leading-6 text-slate-700">
                  {entry.solution.oneLiner}
                </p>
              )}
              <span class="mt-4 inline-block text-sm font-bold text-slate-700 underline-offset-4 decoration-2 group-hover:text-slate-950 group-hover:underline">
                See the app →
              </span>
            </a>
          )
        }
      </div>

      <InstagramReel
        url={entry.instagramUrl}
        day={entry.day}
        class="max-w-[22rem]"
      />
    </div>
  </article>

  {
    (older || newer) && (
      <nav
        aria-label="More days"
        class="grid gap-4 border-t border-slate-200 pt-8 sm:grid-cols-2"
      >
        {older ? (
          <a
            href={`/daily/${older.id}`}
            class="group rounded-lg border border-slate-400 border-b-4 bg-white p-4"
          >
            <span class="text-xs font-extrabold uppercase tracking-wide text-primary-700">
              ← Day {older.day}
            </span>
            <span class="mt-1 block font-bold text-slate-950 group-hover:text-primary-700">
              {older.title}
            </span>
          </a>
        ) : (
          <span />
        )}
        {newer && (
          <a
            href={`/daily/${newer.id}`}
            class="group rounded-lg border border-slate-400 border-b-4 bg-white p-4 text-right"
          >
            <span class="text-xs font-extrabold uppercase tracking-wide text-primary-700">
              Day {newer.day} →
            </span>
            <span class="mt-1 block font-bold text-slate-950 group-hover:text-primary-700">
              {newer.title}
            </span>
          </a>
        )}
      </nav>
    )
  }
</Layout>

<style>
  .daily-prose :global(> * + *) {
    margin-top: 1rem;
  }

  .daily-prose :global(a) {
    color: var(--color-primary-700);
    font-weight: 700;
    text-decoration: underline;
  }
</style>
