---
import Layout from "../components/Layout.astro";
import SolutionGallery from "../components/SolutionGallery.astro";
import { getSolutionGallery } from "../lib/board";

const items = await getSolutionGallery();
---

<Layout
  title="App Gallery"
  description="Explore free, accessible classroom apps built with teachers to solve real problems."
  compactContent
>
  <section>
    <p class="text-sm font-extrabold uppercase tracking-wide text-primary-700">
      Free classroom tools
    </p>
    <h1 class="mt-2 font-display text-4xl text-slate-950 sm:text-5xl">
      App Gallery
    </h1>
    <p class="mt-3 max-w-2xl text-lg leading-8 text-slate-700">
      We've built {items.length} free, accessible apps with teachers. Explore
      them, try them out, and share your feedback.
    </p>

    <div class="mt-8">
      <SolutionGallery items={items} />
    </div>
  </section>
</Layout>
