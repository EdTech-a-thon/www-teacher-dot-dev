---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../components/Layout.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";

export async function getStaticPaths() {
  const newsletters = await getCollection("newsletters");
  return newsletters.map((newsletter) => ({
    params: { slug: newsletter.id },
    props: { newsletter },
  }));
}

interface Props {
  newsletter: CollectionEntry<"newsletters">;
}

const { newsletter } = Astro.props;
const { Content } = await render(newsletter);
const formattedDate = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric",
}).format(new Date(`${newsletter.data.date}T00:00:00`));
---

<Layout
  title={newsletter.data.title}
  description={newsletter.data.preview}
  compactContent
>
  <article class="mx-auto w-full max-w-3xl">
    <a
      href="/newsletters"
      class="py-1 text-sm font-bold text-slate-700 underline-offset-4 decoration-2 transition hover:text-slate-950 hover:underline"
    >
      ← All newsletters
    </a>

    <header class="mt-6">
      <p class="text-sm font-extrabold uppercase tracking-wide text-primary-700">
        {newsletter.data.issueNumber ? `Issue #${newsletter.data.issueNumber} · ` : ""}{formattedDate}
      </p>
      <h1 class="mt-3 text-4xl font-semibold leading-tight text-slate-900">
        {newsletter.data.title}
      </h1>
      <p class="mt-4 text-lg leading-8 text-slate-700">{newsletter.data.preview}</p>
      <div class="mt-8 rounded-lg border border-slate-400 border-b-4 bg-white p-2">
        <Image
          src={newsletter.data.thumbnail}
          alt={newsletter.data.thumbnailAlt || ""}
          class="max-h-[34rem] w-full rounded object-cover"
          widths={[640, 960, 1280]}
          sizes="(min-width: 768px) 768px, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </header>

    <div class="newsletter-prose mt-8 rounded-lg border border-slate-400 border-b-4 bg-white p-6 sm:p-8">
      <Content />
    </div>
  </article>

  <section class="mx-auto w-full max-w-3xl border-t border-slate-200 pt-8">
    <h2 class="text-2xl font-extrabold text-slate-950">Get the next issue</h2>
    <p class="mt-2 text-slate-700">
      Join the newsletter for teacher-built tools, classroom stories, and EdTech-a-thon updates.
    </p>
    <div class="mt-5">
      <NewsletterSignup id={`newsletter-${newsletter.id}`} />
    </div>
  </section>
</Layout>

<style>
  .newsletter-prose :global(*) {
    max-width: 100%;
  }

  .newsletter-prose :global(p) {
    margin: 1rem 0;
    color: var(--color-slate-800);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .newsletter-prose :global(strong) {
    color: var(--color-slate-950);
    font-weight: 800;
  }

  .newsletter-prose :global(a) {
    color: var(--color-primary-700);
    font-weight: 800;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .newsletter-prose :global(img) {
    margin: 1.5rem auto;
    max-height: 28rem;
    border: 1px solid var(--color-slate-300);
    border-radius: 0.5rem;
    object-fit: contain;
  }

  .newsletter-prose :global(hr) {
    margin: 2rem 0;
    border: 0;
    border-top: 1px solid var(--color-slate-200);
  }
</style>
