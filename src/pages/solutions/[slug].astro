---
import Redirect from "../../components/Redirect.astro";
import { getSolutionGallery } from "../../lib/board";

export async function getStaticPaths() {
  return (await getSolutionGallery()).map((solution) => ({
    params: { slug: solution.key },
    props: { to: `/apps/${solution.key}/` },
  }));
}

const { to } = Astro.props;
---

<Redirect to={to} />
