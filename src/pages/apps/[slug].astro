---
import Layout from "../../components/Layout.astro";
import ReelTabs from "../../components/ReelTabs.astro";
import SocialPosts from "../../components/SocialPosts.astro";
import { getSolutionGallery } from "../../lib/board";

export async function getStaticPaths() {
  return (await getSolutionGallery()).map((solution) => ({
    params: { slug: solution.key },
    props: { solution },
  }));
}
const { solution } = Astro.props;
---

<Layout title={solution.name} description={solution.oneLiner || undefined} compactContent>
  <article class="mx-auto w-full max-w-3xl">
    <a href="/apps" class="text-primary-700 hover:underline">← All apps</a>
    <h1 class="mt-4 text-3xl font-extrabold text-slate-900 sm:text-4xl">{solution.name}</h1>
    {solution.oneLiner && <p class="mt-3 text-lg text-slate-600">{solution.oneLiner}</p>}
    {solution.builtBy && <p class="mt-2 text-sm text-slate-500">Built by {solution.builtBy}</p>}
    {solution.screenshot && (
      <img src={solution.screenshot.src} alt={`${solution.name} screenshot`} width={solution.screenshot.width} height={solution.screenshot.height} class="mt-6 w-full rounded-xl" />
    )}
    {solution.descriptionHtml && <div class="description mt-6 text-slate-700" set:html={solution.descriptionHtml} />}
    {solution.link && <a href={solution.link} target="_blank" rel="noopener noreferrer" class="mt-6 inline-block rounded-lg bg-slate-900 px-4 py-3 font-semibold text-white hover:bg-primary-700">Visit app ↗</a>}
    <ReelTabs reels={solution.reels} name={solution.name} class="mt-8 border-t border-slate-200 pt-6" />
    <SocialPosts posts={solution.socialPosts} />
  </article>
</Layout>

<style>
  .description :global(p + p) { margin-top: 1rem; }
  .description :global(a) { text-decoration: underline; }
  .description :global(ul) { list-style: disc; padding-left: 1.5rem; }
  .description :global(ol) { list-style: decimal; padding-left: 1.5rem; }
</style>
