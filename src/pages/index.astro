---
import { Image } from "astro:assets";
import DailyCalendar from "../components/DailyCalendar.astro";
import InstagramReel from "../components/InstagramReel.astro";
import Layout from "../components/Layout.astro";
import NewsletterSignupCard from "../components/NewsletterSignupCard.astro";
import SolutionCarousel from "../components/SolutionCarousel.astro";
import edtechathon2026Group from "../assets/edtechathon-2026-group.jpeg";
import { getSolutionGallery } from "../lib/board";
import { getDailyEntries } from "../lib/daily";

const solutionItems = (await getSolutionGallery()).slice(0, 8);
const dailyEntries = await getDailyEntries();
const latestDaily = dailyEntries[0];
// Finishes "We built …": "A math facts drill website" becomes "a math facts
// drill website", while a name like "Test Parrot" keeps its capitals.
const builtThing = latestDaily?.title.replace(/^(A|An|The)\b/, (article) =>
  article.toLowerCase(),
);
const organizers = [
  {
    id: "josh-pullen",
    name: "Josh Pullen",
    headshot: "/Josh.png",
    siteLabel: "joshuapullen.com",
    siteHref: "https://www.joshuapullen.com/",
    blurb:
      "An Algebra teacher and web developer from South Lyon, Michigan, Josh Pullen builds practical EdTech apps for his classroom and shares them with other teachers. He has developed interactive math lessons for 3Blue1Brown and is the creator of Shuffle Buddy, a specialized seating chart generator. Josh's work provides simple, effective tools that solve the day-to-day challenges teachers actually face.",
  },
  {
    id: "jessika-golab",
    name: "Jessika Golab",
    headshot: "/Jess.png",
    // siteLabel: 'msgolab.com',
    // siteHref: 'https://www.msgolab.com/',
    blurb:
      "A middle school math teacher in Walled Lake, MI, Jessika Golab is a passionate supporter and advocate for her students. Jessika’s classroom is adorned with a wall of over 250 rubber and plastic ducks, each one a gift from a student who appreciates her fun and caring presence. Jessika leads her school’s WEB program, where she trains 8th grade leaders to provide mentorship and support to every 6th grade student as they step into middle school life for the first time.",
  },
  {
    id: "duncan-johnson",
    name: "Duncan Johnson",
    headshot: "/Duncan.png",
    siteLabel: "duncanajohnson.com",
    siteHref: "https://www.duncanajohnson.com/",
    blurb:
      "An EdTech researcher and designer from Boston, Massachusetts, Duncan Johnson builds educational technology for universities and companies alike. He previously co-founded a STEM education non-profit with Elliot Roe and has published computer science education research with the Tufts University Center for Engineering Education and Outreach.",
  },
  {
    id: "elliot-roe",
    name: "Elliot Roe",
    headshot: "/Elliot.png",
    siteLabel: "elliotbroe.com",
    siteHref: "https://elliotbroe.com/",
    blurb:
      "A full-time software engineer from Atlanta, Georgia, Elliot Roe is passionate about open-source software and educational technology. He previously co-founded a STEM education non-profit with Duncan Johnson and worked as a research assistant at the Play and Learn Lab, where he developed educational games and supported after-school programs. Now, Elliot develops open-source tooling for researchers, integrating academic literature with AI.",
  },
  {
    id: "sam-barans",
    name: "Sam Barans",
    headshot: "/Sam.png",
    blurb:
      "A data analyst in the early care and education space, Sam got started building data analytic pipelines and reports for foster care and early psychosis care systems focused on harm reduction and prevention. Throughout HS and college, Sam tutored at Mathnasium for 8 years and TA’d calculus and algebra at Michigan State. Sam’s passion for increasing access to education comes from watching his brother struggle to receive necessary accommodations in school and mentoring youth involved in the juvenile court system.",
  },
  {
    id: "auden-garrard",
    name: "Auden Garrard",
    headshot: "/Auden.png",
    blurb:
      "A PhD student at University of Alabama studying Computer Science, Auden’s interest is primarily in multi-objective optimization. He most recently worked with the Environmental Protection Agency to develop methods for protecting the Chesapeake Bay Watershed. Prior to starting his PhD, he tutored a wide of range math and computer science courses at Michigan State University as well as Lansing Community College. Auden plans to enter higher education with a goal of increasing access to STEM fields for underrepresented groups.",
  },
  {
    id: "kara-auger",
    name: "Kara Auger",
    headshot: "/Kara.png",
    blurb:
      "A Principal Technical Program Manager on Chick-fil-A’s AI Capabilities team, Kara Auger turns emerging AI research into tools that support developers and functional work. Before that, she led product for procurement platforms at Disney, engineered systems at Honeywell Aerospace, and did research at the Georgia Tech Research Institute. She holds a BS in Electrical Engineering and an MS in Cybersecurity from Georgia Tech. Kara has never met an expert who understood a problem better than the person living with it, which is why she is so passionate about the teacher.dev mission.",
  },
];
---

<Layout>
  <section class="-my-4 flex flex-col md:-my-8">
    {
      latestDaily && (
        <div class="grid gap-8 md:grid-cols-[1fr_24rem] md:grid-rows-[auto_1fr] md:gap-x-12">
          <div class="flex flex-col gap-4">
            <h1
              data-daily-sentence
              data-date={latestDaily.date}
              class="text-balance text-2xl leading-snug text-slate-800 sm:text-3xl"
            >
              <span data-daily-when>{latestDaily.monthDayLabel}</span>
              <span data-daily-verb>was</span>
              <mark class="box-decoration-clone rounded-md bg-primary-200 px-2 text-primary-950">Day {latestDaily.day}</mark>
              of solving a teacher's problem every single day.
            </h1>
            <p class="text-xl leading-snug text-slate-800">
              We built{" "}
              <a
                href={`/daily/${latestDaily.id}`}
                class="font-extrabold text-slate-950 underline-offset-4 decoration-2 transition hover:text-primary-700 hover:underline"
              >{builtThing}</a>{/[.!?]$/.test(latestDaily.title) ? "" : "."}
            </p>
            {latestDaily.tryUrl && (
              <a
                href={latestDaily.tryUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-fit rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-primary-700"
              >
                Try it <span aria-hidden="true">→</span>
              </a>
            )}
          </div>

          <InstagramReel
            url={latestDaily.instagramUrl}
            day={latestDaily.day}
            class="max-w-[24rem] md:col-start-2 md:row-span-2 md:row-start-1"
          />

          <div class="md:col-start-1 md:row-start-2">
            <h3 class="mb-2 text-sm font-extrabold uppercase tracking-wide text-primary-700">
              Past problems solved
            </h3>
            <DailyCalendar entries={dailyEntries} />
          </div>
        </div>
      )
    }
  </section>

  <div>
    <SolutionCarousel items={solutionItems} />

    <section aria-labelledby="homepage-newsletter-heading">
      <NewsletterSignupCard
        id="homepage-newsletter"
        title="Follow along by joining our monthly newsletter"
      />
    </section>
  </div>

  <section
    aria-labelledby="community-heading"
    class="grid items-center gap-12 md:grid-cols-[1fr_auto]"
  >
    <div class="flex flex-col gap-4">
      <p class="text-sm font-extrabold uppercase tracking-wide text-primary-700">
        Our community
      </p>
      <h2 id="community-heading" class="font-display text-4xl text-slate-950">
        Teachers and developers, building together
      </h2>
      <p class="text-lg leading-8 text-slate-700">
        Teachers and developers live in different worlds. At EdTech-a-thon
        2026, we brought them together from July 20–22, virtually and in person
        in Atlanta, GA, for three days of collaboration, community, and problem
        solving. The first apps in our gallery were built there.
      </p>
      <a
        href="/events/edtech-a-thon-2026"
        class="w-fit py-1 text-sm font-bold text-slate-700 underline-offset-4 decoration-2 transition hover:text-slate-950 hover:underline"
      >
        About EdTech-a-thon 2026 →
      </a>
    </div>
    <div class="w-full pb-4 md:w-72 md:pr-4">
      <div
        class="polaroid-stack"
        aria-label="Teachers and developers collaborating"
      >
        <figure class="polaroid polaroid-back" aria-hidden="true">
          <img src="/hero-3.jpg" alt="" loading="lazy" />
        </figure>
        <figure class="polaroid polaroid-middle" aria-hidden="true">
          <img src="/hero-2.jpg" alt="" loading="lazy" />
        </figure>
        <figure class="polaroid polaroid-front">
          <Image
            src={edtechathon2026Group}
            alt="Teachers and developers gathered together with virtual attendees joining onscreen"
            width={576}
            widths={[320, 576]}
            sizes="288px"
            loading="lazy"
          />
          <figcaption class="polaroid-caption font-handwritten">
            EdTech-a-thon 2026
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section aria-labelledby="organizers-heading">
    <h2 id="organizers-heading" class="font-display text-4xl text-slate-950">
      Our Team
    </h2>
    <p class="mt-2">
      EdTech-a-thon is organized by an amazing team of teachers and developers
      passionate about helping teachers. We're backed by <a
        class="underline"
        href="https://bxcoding.org">BX Coding</a
      >, a 501(c)(3) education non-profit, which allows EdTech-a-thon to be
      wholly commited to providing free & accessible resources for teachers.
    </p>
    <div class="mt-8 divide-y divide-slate-200 border-t border-slate-200">
      {
        organizers.map((organizer) => (
          <article
            id={organizer.id}
            class="grid gap-5 py-6 sm:grid-cols-[96px_1fr]"
          >
            <img
              src={organizer.headshot}
              alt={`${organizer.name} headshot`}
              class="h-[150px] rounded-lg border border-dashed border-slate-400 object-cover"
            />
            <div>
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="text-2xl font-extrabold text-slate-950">
                  {organizer.name}
                </h3>
                {organizer.siteHref && (
                  <a
                    href={organizer.siteHref}
                    target="_blank"
                    rel="noreferrer"
                    class="text-xs font-bold uppercase text-slate-500 transition hover:text-slate-950"
                  >
                    {organizer.siteLabel}
                  </a>
                )}
              </div>
              <p class="mt-3 text-base leading-7 text-slate-700">
                {organizer.blurb}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>

<script>
  // The page is built ahead of time, so "Today" and "Yesterday" are worked out
  // in the visitor's browser. Without this the sentence just names the date.
  const sentence = document.querySelector<HTMLElement>("[data-daily-sentence]");
  const when = sentence?.querySelector("[data-daily-when]");
  const verb = sentence?.querySelector("[data-daily-verb]");
  if (sentence && when && verb) {
    const localIso = (date: Date) =>
      [date.getFullYear(), date.getMonth() + 1, date.getDate()]
        .map((n) => String(n).padStart(2, "0"))
        .join("-");
    const now = new Date();
    const yesterday = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1);
    if (sentence.dataset.date === localIso(now)) {
      when.textContent = `Today, ${when.textContent},`;
      verb.textContent = "is";
    } else if (sentence.dataset.date === localIso(yesterday)) {
      when.textContent = `Yesterday, ${when.textContent},`;
    }
  }
</script>
